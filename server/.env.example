# EduMitra-AI Environment Configuration

# ─── Frontend Environment Variables (client/.env.local) ───
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# ─── Backend Environment Variables (server/.env) ───
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-2.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# OpenRouter Fallback (Optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL_ID=meta-llama/llama-3.3-70b-instruct:free

# Server Environment & CORS
ENVIRONMENT=development
ADDITIONAL_ORIGINS=http://localhost:3000
